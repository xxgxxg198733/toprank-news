# === AI 提供商 ===
# 豆包 (ByteDance) API Key — 默认模型
DOUBAO_API_KEY=ark-your-doubao-key

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI API Key (GPT / DALL·E)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic Claude API Key (可选)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google Gemini API Key (可选)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-key

# Fal.ai Key (视频生成，可选)
FAL_KEY=your-fal-key

# === 认证 ===
# 生成: npx auth secret
AUTH_SECRET=your-auth-secret

# Google OAuth (https://console.cloud.google.com)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# === 数据库 ===
# Vercel KV (https://vercel.com/dashboard/stores)
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# === Payment ===
# PayPal Sandbox (https://developer.paypal.com/dashboard/applications)
# Switch to api-m.paypal.com for production
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
